# Settings for docker-compose.yml. In Portainer enter them under "Environment variables"
# (or use "Load variables from .env file"); with plain Docker Compose copy this file to .env.
# All variables are optional – the values shown are the defaults.

# Image tag: latest (newest state of main) or a release such as 0.2.0
IMAGE_TAG=latest
# Port on the Docker host
HTTP_PORT=8080
# true once the UI is only reachable via HTTPS (reverse proxy)
COOKIE_SECURE=false
# Behind a reverse proxy: number of proxy hops, usually 1
TRUST_PROXY=
# Validity of a login session in days
SESSION_DAYS=30
